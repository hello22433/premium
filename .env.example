# ======== 협력사 정산 원장 ========
# producer와 review 해소 API는 독립 kill switch이며, 배포 기본값은 모두 off다.
PARTNER_SETTLE_LEDGER_ENABLED=false
PARTNER_SETTLE_LEDGER_PROVIDERS=
PARTNER_SETTLE_REVIEW_RESOLUTION_ENABLED=false
SETTLE_CREDIT_API_ENABLED=false

# ======== 발신 Webhook HMAC 서명 ========
# 쿠폰 폐기 통보 Webhook(X-Webhook-Signature)에 사용하는 공유 시크릿.
# 수신 측(club/template)과 바이트 단위로 동일한 값을 주입해야 한다. 실제 값은 커밋 금지(env/SSM 주입).
# 미설정 시 sender 는 무서명 + WARN 으로 발송한다(롤아웃 한정).
WEBHOOK_HMAC_SECRET=

# ======== 입금내역 동기화 (erp_macro 조회 API pull) ========
# 계약: docs/API계약-erp_macro-입금내역-조회.md · 배포 절차: docs/입금내역-배포운영-런북.md
#
# ⚠️⚠️ 아래 3개(ENABLED / BASE_URL / API_KEY)는 **서버 .env 에 넣지 말고 SSM 에만 둔다.**
#   SSM 주입(src/config/hydrate-env-from-ssm.ts)은 `process.env[key] === undefined` 일 때만
#   값을 채운다. .env 에 키가 **빈 값으로라도 존재하면 그것이 이겨서** SSM 의 진짜 값이 무시되고,
#   증상은 "키를 제대로 넣었는데 계속 인증 실패"로 나타나 원인을 찾기 어렵다.
#   SSM 경로: /epopkon-premium/{dev|prod}/<키 이름>  (API_KEY 는 SecureString)
#   이 파일의 세 줄은 **어떤 이름이 필요한지 보여주는 목록**일 뿐이다.
#
# ⚠️ 기본 꺼둠. 상대 API 와 회선(HTTPS·IP 허용)이 준비된 환경에서만 true 로 켠다.
#    켜기 전에 migration/bank-deposit-mirror.sql 을 먼저 적용해야 한다.
DEPOSIT_SYNC_ENABLED=false
ERP_MACRO_API_BASE_URL=
ERP_MACRO_API_KEY=
# 거래내역 조회(/api/deposits) 타임아웃. 배치에서만 쓰므로 넉넉히 잡는다.
ERP_MACRO_API_TIMEOUT_MS=30000
# 수집상태(/api/status) 타임아웃 — **화면 요청 경로**라 훨씬 짧게 잡는다.
# 이 값이 길면 스크래핑 서버가 죽었을 때 조회 화면이 그만큼 멈춘다(미러를 두는 이유가 사라진다).
ERP_MACRO_STATUS_TIMEOUT_MS=3000
# 매 주기 다시 받아올 최근 구간(일). 회계전표가 뒤늦게 반영되는 건까지 덮는다.
DEPOSIT_SYNC_RESYNC_DAYS=30
DEPOSIT_SYNC_PAGE_SIZE=500
# 미러가 비어 있을 때 백필 시작일(실데이터는 2025-06 부터)
DEPOSIT_SYNC_BACKFILL_FROM=2020-01-01
